# PostgreSQL (Neon / Supabase / other). Required on Vercel.
DATABASE_URL=
# Generated by npm run setup. Never use NEXT_PUBLIC_ for these values.
ADMIN_PASSWORD_HASH=
CREDENTIAL_ENCRYPTION_KEY=
BOT_TRADING_MODE=paper
# Must remain false until Demo orders and native protections are verified.
ALLOW_MAINNET_LIVE=false
# Exact public URL after deployment, e.g. https://your-project.vercel.app
APP_ORIGIN=http://localhost:3000
# LOCAL_DATABASE_PATH is only for local development/testing, never Vercel.
LOCAL_DATABASE_PATH=.local/dashboard.db
